{
  "name": "@gatrix/ripple",
  "version": "1.0.2",
  "description": "Distributed Refresh Orchestrator - broadcast refresh events across all servers via Redis Pub/Sub",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "clean": "rimraf dist",
    "prepublishOnly": "yarn build",
    "deploy:game": "ts-node scripts/deploy-to-game-server.ts",
    "deploy:game:bump": "ts-node scripts/deploy-to-game-server.ts --bump",
    "demo": "ts-node scripts/demo.ts"
  },
  "keywords": [
    "refresh",
    "broadcast",
    "redis-streams",
    "distributed",
    "fanout",
    "orchestrator"
  ],
  "author": "Gatrix Team",
  "license": "MIT",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "ioredis": "^4.14.1",
    "minimatch": "^10.0.1",
    "nanoid": "3.3.4",
    "prom-client": "^15.1.3"
  },
  "peerDependencies": {
    "express": "^4.18.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "express": "^4.21.0",
    "jest": "^29.7.0",
    "rimraf": "^3.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.2"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "README.ko.md",
    "LICENSE"
  ]
}
